{
  "manifest_version": 3,
  "name": "Self Annotate",
  "version": "1.4.5",
  "description": "Self Annotate — Annotation Tool & Whiteboard for any webpage or local HTML file.",
  "icons": {
    "48":  "icons/icon48.png",
    "96":  "icons/icon96.png"
  },
  "action": {
    "default_icon": {
      "48": "icons/icon48.png",
      "96": "icons/icon96.png"
    },
    "default_title": "Self Annotate",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>",
    "file://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [],
  "web_accessible_resources": [{
    "resources": ["whiteboard.html"],
    "matches": ["<all_urls>"]
  }]
}
